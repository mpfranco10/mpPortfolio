{
  "name": "mpf-portfolio",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://mpfranco10.github.io/mpPortfolio",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.2.1",
    "@fortawesome/free-brands-svg-icons": "^6.2.1",
    "@fortawesome/free-solid-svg-icons": "^6.2.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
